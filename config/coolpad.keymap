#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        new_behavior: new_behavior {
            compatible = "zmk,behavior-soft-off";
            label = "NEW_BEHAVIOR";
            #binding-cells = <0>;
            hold-time-ms = <900>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp C_MUTE      &tog 1
&kp C_PREVIOUS  &kp C_PP        &kp C_NEXT
&kp LC(C)       &kp LC(V)       &kp LC(X)
&kp LS(LC(F8))  &kp LC(LS(F7))  &studio_unlock
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };

        layer_1 {
            bindings = <
              &trans        &tog 0
&bt BT_PRV    &none         &bt BT_NXT
&bt BT_SEL 0  &bt BT_SEL 1  &none
&bt BT_CLR    &soft_off     &studio_unlock
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };
    };
};
